{
  "manifest_version": 3,
  "name": "Web Counter Monitor",
  "version": "2.0.0",
  "description": "Monitors a numeric counter on any web page and raises desktop and phone (ntfy.sh) alerts whenever the count changes.",
  "permissions": ["storage", "notifications", "tabs", "alarms", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "host_permissions": ["https://ntfy.sh/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Web Counter Monitor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}